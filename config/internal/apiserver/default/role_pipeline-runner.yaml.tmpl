apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: pipeline-runner-{{.Name}}
  namespace: {{.Namespace}}
  labels:
    app: {{.APIServerDefaultResourceName}}
    component: data-science-pipelines
rules:
{{- if and .ObjectStorageConnection.CredentialsSecret .ObjectStorageConnection.CredentialsSecret.SecretName }}
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames:
      - {{ printf "%q" .ObjectStorageConnection.CredentialsSecret.SecretName }}
    verbs: ["get"]
{{- end }}
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: ["kfp-launcher"]
    verbs: ["get"]
  # The driver reads its own Pod metadata to publish Kubernetes task results.
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get"]
  # The Kubernetes platform driver supports pipeline steps that create and delete PVCs.
  - apiGroups: [""]
    resources: ["persistentvolumeclaims"]
    verbs: ["create", "get", "delete"]
  - apiGroups: ["argoproj.io"]
    resources: ["workflowtaskresults"]
    verbs: ["create", "patch"]
