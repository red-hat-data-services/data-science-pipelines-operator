apiVersion: admissionregistration.k8s.io/v1
kind: MutatingWebhookConfiguration
metadata:
  name: workflow-account
  annotations:
    service.beta.openshift.io/inject-cabundle: "true"
webhooks:
  - name: workflow-account.opendatahub.io
    admissionReviewVersions: ["v1"]
    clientConfig:
      service:
        namespace: {{.DSPONamespace}}
        name: dspo-workflow-admission
        path: /validate-workflow-account
        port: 9443
    failurePolicy: Ignore
    sideEffects: None
    timeoutSeconds: 5
    rules:
      - operations: ["CREATE", "UPDATE"]
        apiGroups: ["argoproj.io"]
        apiVersions: ["v1alpha1"]
        resources: ["workflows", "workflows/status", "cronworkflows", "cronworkflows/status"]
        scope: Namespaced
      - operations: ["CREATE", "UPDATE"]
        apiGroups: ["kubeflow.org"]
        apiVersions: ["v1beta1"]
        resources: ["scheduledworkflows", "scheduledworkflows/status"]
        scope: Namespaced
